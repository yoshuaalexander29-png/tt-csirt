{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "start": "node server.js",
    "build": "vite build && vite build -c vite.publishing.config.ts",
    "build:publishing": "vite build -c vite.publishing.config.ts",
    "dev": "vite",
    "lint": "tsc --noEmit",
    "test:canonical": "node --experimental-strip-types --test tests/canonical-contracts.test.mjs && node --experimental-strip-types tests/canonical-smoke-import.mjs",
    "test:publishing": "node --experimental-strip-types --test tests/publishing/publishing-workflow.test.mjs tests/publishing/dev-auth-boundary.test.mjs tests/publishing/publication-integration.test.mjs",
    "test:incident-email": "node scripts/test-incident-email.mjs",
    "test": "node --experimental-strip-types --test tests/advisory-editorial-normalization.test.mjs && node --test tests/statistics-analysis.test.cjs tests/canonical-statistics-engine.test.cjs tests/legacy-statistics-compatibility.test.cjs tests/cyber-security-incident-taxonomy.test.cjs tests/navigation-regression.test.cjs tests/gds-statistics-components.test.cjs tests/latest-statistics-grid.test.cjs && node tests/run-search-tests.mjs && node tests/incident-reporting.test.mjs && node --test tests/security-headers.test.mjs && node --experimental-strip-types --test tests/safe-html-fallback.test.mjs"
  },
